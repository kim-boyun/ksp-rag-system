# ================================
# GPU 서버 vLLM 설정
# ================================
# 이 파일은 GPU 서버에서 vLLM을 실행할 때 사용합니다.
# 운영 서버(이 레포)에서는 사용하지 않습니다.
#
# 사용법:
#   cp .env.gpu.example .env.gpu
#   vim .env.gpu  # 필요시 수정

# vLLM 모델 설정
SERVER_LLM_MODEL=openai/gpt-oss-120b

# GPU 설정
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.9
MAX_MODEL_LEN=4096

# 포트 설정 (기본값: 8000)
# PORT=8000
