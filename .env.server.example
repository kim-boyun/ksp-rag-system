# ================================
# 서버 운영 모드 설정
# ================================
MODE=server
RETRIEVER_MODE=elastic  # local | elastic

# LLM Provider
LLM_PROVIDER=server_http  # local_api | server_http

# Elasticsearch
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_INDEX_NAME=ksp_rag_index

# 서버 LLM (외부 vLLM HTTP endpoint)
# GPU 서버에서 별도로 운영되는 vLLM 서비스의 base URL
# 예: http://172.16.0.52:8000
# 또는 같은 서버에 있다면: http://host.docker.internal:8000
SERVER_LLM_BASE_URL=http://172.16.0.52:8000
SERVER_LLM_MODEL=openai/gpt-oss-120b

# [Deprecated] SERVER_LLM_ENDPOINT는 하위 호환성을 위해 지원하지만,
# SERVER_LLM_BASE_URL 사용을 권장합니다.
# SERVER_LLM_ENDPOINT=http://172.16.0.52:8000/v1/completions

# LLM 설정
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# 문서 처리
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# 인제스트 시 차트/이미지 추출 (false = 텍스트+표만, 속도 빠름)
EXTRACT_FIGURES=false

# 검색 설정
TOP_K=12
RERANK_TOP_K=5

# 캐시
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# 쿼리 확장
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_NUM_QUERIES=3

# 로그 레벨
LOG_LEVEL=INFO
