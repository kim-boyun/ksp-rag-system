# ================================
# 로컬 개발 모드 설정
# ================================
MODE=local
RETRIEVER_MODE=local  # local | elastic

# 로컬 임베딩 모델
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM Provider
LLM_PROVIDER=local_api  # local_api | server_http

# LLM API (OpenAI)
LLM_API_TYPE=openai
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# 문서 처리
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# 인제스트 시 차트/이미지 추출 (false = 텍스트+표만, 속도 빠름)
EXTRACT_FIGURES=false

# 검색 설정
TOP_K=12
RERANK_TOP_K=5

# 캐시 (반복 질의 시 응답 재사용)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# 쿼리 확장 (여러 표현으로 검색 후 RRF 병합)
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_NUM_QUERIES=3

# 로그 레벨
LOG_LEVEL=INFO
