# ================================
# Elasticsearch 검색 + 개인 LLM
# ================================
# 복사: cp .env.local.example .env.local
# .env.local 에서 LLM_API_KEY, LLM_MODEL 등만 수정 후 사용

MODE=local
RETRIEVER_MODE=elastic

# Elasticsearch (Docker 서비스명, 같은 네트워크에서 접속)
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_INDEX_NAME=ksp_rag_index
ELASTIC_BM25_BOOST=1.0
ELASTIC_DENSE_BOOST=1.0
RETRIEVAL_MIN_SCORE=0.0

# 개인 LLM (OpenAI API / Ollama 등)
LLM_PROVIDER=local_api
LLM_API_TYPE=openai
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# 문서 처리
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# 인제스트 시 차트/이미지 추출 (false = 텍스트+표만, 속도 빠름)
EXTRACT_FIGURES=false

# 검색 설정
TOP_K=12
RERANK_TOP_K=5

# 캐시 (반복 질의 시 응답 재사용)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# 쿼리 확장 (여러 표현으로 검색 후 RRF 병합)
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_NUM_QUERIES=3

# 로그 레벨
LOG_LEVEL=INFO
